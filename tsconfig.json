{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "routes.ts",
    "site-config.ts",
    "content.ts",
    "vite.config.ts",
    "components/**/*.tsx",
    "pages/**/*.tsx",
    "integrations/**/*.ts",
    "tools/**/*.ts"
  ]
}
